  "human_verification": [
    {
      "item": "实体卡打印尺寸（是否 100% 原尺寸）",
      "steps": "① 生成：`liveblocks cardsheet render --out sheet.png --pdf sheet.pdf`；② 打印时关掉「适应页面 / Fit to page」，按 100%（实际尺寸）出纸；③ 卡尺量任意 3 张卡的长边与短边（卡面版式 card-60x40 标称 60×40 mm）与任一标记边长（标称 24 mm），把实测值连打印机型号一起记进 Issue；④ 偏差超过 1 mm 先查打印缩放，**不要**回头改标称值。"
    },
    {
      "item": "打印后模块边长与边缘质量",
      "steps": "① 打印同一张页；② 用放大镜或手机微距看任一标记的 6×6 模块：黑边是否连贯、最小模块有没有断线或糊边；③ 卡尺量 6 个模块的总长（标称 24 mm）并记实测；④ 结论写进 `docs/PROGRESS.md` 的「待硬件验证」，不要写成「已验证」。"
    },
    {
      "item": "卡面 2.5 mm 静区在实体卡上是否够用",
      "steps": "卡面声明静区 2.5 mm **小于**静区规则 4 mm（1 个模块）。① 把打印好的卡紧贴另一张卡、再紧贴深色桌面/深色物件摆放；② 用 `liveblocks serve-cam serve` 抓 10 帧以上，看 `liveblocks recognize detect` 是否仍给出正确 `marker_id`；③ 若漏检，把「静区不足」记进 Issue，再决定是否提高版式的 `marker_quiet_zone_mm`（改版式要重生成 fixtures）。"
    },
    {
      "item": "基材与打印工艺",
      "steps": "① 选一种基材（80 g 纸 / 200 g 卡纸 / PVC）与一种工艺（激光 / 喷墨 / 外协）；② 按上一条打印并测量；③ 记录翘曲、反面透印、墨粉反光对识别的影响；④ 只有实测记录才能把「基材」「打印工艺」两项从「待实测」移出。"
    },
    {
      "item": "可识别距离与角度",
      "steps": "① 实体卡平放桌面，用 `liveblocks serve-cam serve` 在 0.3 / 0.5 / 0.8 m 与 0° / 15° / 30° 倾角各抓 10 帧；② 记检出率与漏检帧；③ 结论必须带设备型号、分辨率、距离、帧数，缺一项就不算实测。"
    },
    {
      "item": "裁切线是否实用",
      "steps": "① 按灰线手剪一张卡；② 量剪出来的卡与标称尺寸的偏差；③ 若裁切线压在卡面墨迹上或离得太远，记下实际手剪偏差，再决定是否调整 `CUT_GAP_MM`（属下一轮的设计改动，不在本单）。"
    }
  ]
}
