# 虚拟环境
.venv/
venv/

# Python 产物
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# 运行产物（LB-009：`liveblocks e2e run/regression` 的默认输出目录；
# 记录里的 `timings_ms` 是实测墙钟，每跑一次都不一样，不入库）
runs/

# LB-030 实拍采集样本（人现场采的，一采就变；只留目录说明）
fixtures/live/*
!fixtures/live/README.md

# 测试产物
.pytest_cache/
.coverage
htmlcov/

# 编辑器
.vscode/
.idea/
.DS_Store

# LB-034 固件骨架：生成的头文件、sdkconfig 与构建目录都不入库
# （引脚与协议常量只能有一个来源：config/board.esp32c3-supermini.json 与 src/liveblocks/hw/）
firmware/generated/*.h
firmware/sdkconfig
firmware/sdkconfig.old
